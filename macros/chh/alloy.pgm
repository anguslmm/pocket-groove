# ALLOY -- family: MATERIAL / BODY.
# Idea: what is being hit, rather than how:
#   WD-MTL  wood/seed: pure noise through a resonant band, like a shaker or a
#           brush .. metal: the six-oscillator bank alone, widely spread,
#           ringing like a bell-ish cymbal
#   SIZE    a tiny, high, tight thing .. a big, low, slower one
#   DAMP    left to ring .. choked by a hand: shorter and darker
# Feel if it works: the hat line keeps its rhythm but changes instrument;
# halfway along WD-MTL is the classic 808 mix of both.
# Try: WD-MTL on X, SIZE on Y with 16ths; DAMP on the off-beats.
voice chh
name ALLOY
about "From seed shaker to metal bell."
base snap=40 tone=80

macro WD-MTL 0.6 "WOOD" "METAL"
  mtl      0:0 0.6:84 1:127
  colr     0:100 0.6:56 1:24        # wood: a resonant band does the colouring
  sprd     0:40 0.6:64 1:110        # metal: inharmonic spread
  tone     add 0:-18 0.6:0 1:6
  lvl      0:100 0.6:92 1:88

macro SIZE 0.5 "TINY" "BIG"
  tune     0:118 0.5:64 1:12
  dcy      0:30 0.5:58 1:96
  tone     add 0:14 0.5:0 1:-18
  lvl      add 0:-2 0.5:0 1:2

macro DAMP "RINGING" "CHOKED"
  dcy      mul 0:1 1:0.3
  tone     add 0:0 1:-24
  snap     add 0:0 1:30             # a choked hat is mostly its tick
  lvl      add 0:0 1:5
