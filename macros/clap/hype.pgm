# HYPE -- family: ENERGY.
# Idea: MORE is more of everything at once: more hands (bursts), tighter and
# faster together, brighter, more air, more crunch, a longer tail. CALM is a
# different kind of quiet, not less: a relaxed, scattered crowd in a bigger,
# rounder, wetter room.
# Feel if it works: tilting toward MORE is the crowd getting excited; toward
# CALM it is the same crowd at 4 am.
# Try: MORE on X, CALM on Y, claps on 2 and 4; ride MORE into a drop.
voice clap
name HYPE
about "More hands, or a calm far crowd."
base tone=56 res=50 decay=54 tail=66 bursts=3 spread=64 air=46 drive=28

macro MORE
  bursts   0:2 0.4:3 0.75:4 step       # stepped: one more hand at 0.4 and at 0.75
  spread   0:76 1:40                   # tighter, faster bursts
  tone     0:46 1:82
  air      0:30 1:104
  drive    0:16 1:92
  tail     0:58 1:90
  lvl      0:110 1:94                  # drive and air are louder than their compensation

macro CALM
  spread   mul 0:1 1:1.7               # the hands scatter
  res      0:50 1:104                  # a rounder, ringing body
  tone     add 0:0 1:-28
  decay    0:54 1:96
  air      mul 0:1 1:0.4
  rev      0:44 1:104
  lvl      add 0:0 1:-4
