# SWARM -- family: ODD (stepped, and a pair that only makes sense together).
# Idea: the clap as a pitched, countable thing.
#   HANDS  jumps through how many hands there are: a single slap, two, a
#          flam, a crowd, a long smear (bursts and spacing step together)
#   PITCH  steps the clap's band through five notes of a minor pentatonic
#          (about A5 C6 D6 E6 G6); alone, at the default width, this is
#          only a brightness change ...
#   RING   ... but RING narrows the band until the clap rings at its pitch,
#          so PITCH + RING together play a tuned, knocking clap melody
#          (the five values sit near those notes; nothing is exactly in tune)
# audit: allow-dead HANDS
# audit: allow-dead PITCH
# audit: allow-jump HANDS
# Feel if it works: a toy; you play the clap as an instrument, clicking
# HANDS and PITCH on the beat.
# Try: PITCH on X, RING on Y: set RING high, then click along X in time.
voice clap
name SWARM
base tone=60 res=40 decay=50 tail=60 air=40 drive=26

macro PITCH 0.4
  tone     0:39 0.2:51 0.4:58 0.6:66 0.8:78 step   # band centre ~ 880 1046 1175 1319 1568 Hz
macro RING
  res      0:40 1:127
  tail     add 0:0 1:-12          # a ringing body needs less tail noise
  air      mul 0:1 1:0.3
  decay    add 0:0 1:-10
  lvl      0:100 1:114            # a narrow band passes less noise: lift it
macro HANDS 0.6
  bursts   0:0 0.2:1 0.4:2 0.6:3 0.8:4 step
  spread   0:20 0.2:30 0.4:56 0.6:70 0.8:118 step
  tail     add 0:12 0.2:4 0.4:0 0.8:12 step   # the single slap is all tail
