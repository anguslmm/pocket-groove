# GROWL: the FM pair and the folder, for bass-house.
voice bass
name GROWL
base fmix=127 fmratio=1 cutoff=70 reso=30 envmod=40 timbreenv=60 sub=70

macro GROWL 0.3
  fmdepth  0:20 1:110
  fold     0:0 0.4:20 1:90 smooth
  fmratio  0:1 0.5:2 0.85:3.5 1:7     # stepped through the ratios
macro DARK
  cutoff   0:110 1:30
  reso     0:20 0.5:60 1:40
