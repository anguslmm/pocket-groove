# TRIO -- family: MORPH.
# Idea: three whole kicks at the corners of the pad, every parameter
# crossfading between them:
#   base   (bottom left)  808    low, long, soft-edged, almost no click
#   909    (X = 1)        tighter, punchy, a bright click on top
#   GABBA  (Y = 1)        distorted, held, hard: the rave kick
# Each macro morphs from the base toward its patch (model v2 "morph"); with
# both up the pad mixes the two (top right: half 909, half gabber), so the
# top edge is a real 909-to-gabber road, not only a click control as in
# round 1.
# Feel if it works: one move takes the groove from hip-hop to house to
# hardcore, and the halfway kicks are real hybrids, not mush.
# Try: 909 on X, GABBA on Y, four on the floor; drag a slow circle.
voice kick
name TRIO
about "808, 909 and gabber, blended."
base tune=44 decay=96 punch=52 sweep=74 click=18 cton=24 tone=70 hold=44 drive=16 harm=30 lvl=100   # the 808

patch 909   tune=62 decay=46 punch=88 sweep=44 click=92 cton=62 tone=108 hold=20
patch GABBA tune=56 decay=66 punch=112 sweep=26 drive=118 hold=70 harm=80 lvl=88   # distortion is louder than its compensation

macro 909 "808" "909" "long, soft .. tight, a bright click"
  morph 909

macro GABBA "808" "GABBA" "toward the distorted, held rave kick"
  morph GABBA
  drive    add 0:0 0.5:3 1:0          # round 1's drive bulged a little above a straight line
