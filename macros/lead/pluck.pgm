# PLUCK -- family: GESTURE (sampler).
# Idea: the sample as a keyed instrument. Each note starts the sample at the
# same point and plays it once, like a key struck: the length and the tone of
# the strike are the macros, not the sample's own length.
#   TONE    a dark thud .. a bright, snapping attack (the filter and how far
#           the newest note's filter envelope opens it)
#   LENGTH  a short pluck .. a ringing key that holds while the key is down
#   START   where in the sample a note starts: its head .. its middle
#   SNAP    a soft touch .. a hard, driven strike
# Feel if it works: chords and short lines sound like a keyboard made of the
# sample; TONE and LENGTH on the pad play like a filter and a damper.
# Try: chord mode AUTO, TONE on X, LENGTH on Y, then a line with slides.
voice lead sampler
name PLUCK
about "The sample struck like a key."
tilt x TONE
tilt y LENGTH
base loop=one attack=0 sustain=0 fdcy=44 filter=lp glide=40

macro TONE 0.5 "DARK" "BRIGHT" "a dark thud .. a bright snap"
  cutoff   0:50 0.5:70 1:100
  env      0:18 0.5:40 1:62
  reso     0:8 1:34
  fdcy     0:30 1:60

macro LENGTH 0.4 "SHORT" "RING" "a short pluck .. a ringing key"
  decay    0:22 0.5:62 1:104
  sustain  0:0 0.6:0 1:64
  release  0:16 1:72
  length   0:40 0.5:100 1:127
  trim     0:3 0.5:0 1:-4

macro START 0 "HEAD" "MIDDLE" "where in the sample a note starts"
  start    0:0 1:64

macro SNAP 0.3 "SOFT" "HARD" "a soft touch .. a hard, driven strike"
  attack   0:20 0.3:2 1:0
  drive    0:0 0.3:6 1:96
  env      add 0:-6 0.3:0 1:24
  reso     add 0:0 0.3:0 1:24
  trim     0:2 0.3:0 1:-9
