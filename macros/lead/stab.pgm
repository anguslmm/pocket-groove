# STAB: house chord stabs. LONG couples the note length with vibrato: a
# short stab stays still, a long note starts to sing (and the vibrato slows).
voice lead
name STAB
base osc2=saw intv=24 sus=0 attack=0 flt=lp drive=10

macro BRITE 0.5
  cutoff   0:40 1:105 smooth
  env      0:20 0.7:70 1:60
  reso     0:20 1:55
macro LONG
  decay    0:20 1:96
  release  0:20 1:80
  vibrato  0:0 0.4:0 1:40
  lforate  0:80 1:60
macro WIDE
  detune   0:20 1:90
  wave     0:saw 0.6:supr
  width    0:40 1:127
  rev      add 0:0 1:30               # a mixer row: more reverb send as it widens
