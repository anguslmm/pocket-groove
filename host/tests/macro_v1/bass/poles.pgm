# POLES -- family: OPPOSITES.
# Idea: each macro is an axis between two words; the middle (where every macro
# starts) is a plain round house bass, and both ends of every axis are a
# usable sound of their own, not "off" and "max".
#   DK-BRT  dark (a muffled dub thump)      .. bright (an open, keytracked pluck)
#   SF-HRD  soft (slow attack, round, sub)  .. hard (instant, accented, driven, resonant)
#   SH-LNG  short (a staccato blip)         .. long (held notes that glide)
#   CL-DRT  clean (pure, sub-heavy)         .. dirty (folded and driven)
# Feel if it works: you think in words ("darker and softer") and the hands go
# there; no axis has a wrong end.
# Try: DK-BRT and SF-HRD on the pad, start in the centre and push to each edge.
voice bass
name POLES
base wave=36 cutoff=48 reso=50 envmod=50 decay=48 accent=70 sub=60 fmix=0 lfodepth=0 slide=50 ktrk=40

macro DK-BRT 0.5
  cutoff   0:19 0.5:48 1:96 smooth
  envmod   0:22 0.5:50 1:84
  ktrk     0:10 0.5:40 1:90
  reso     add 0:-20 0.5:0 1:10
  wave     0:10 0.5:36 1:60        # dark: nearly a saw (fewer bright edges under a closed filter);
                                   # bright: square, hollow and present
  lvl      0:110 0.5:100 1:94      # the dark end loses level through the closed filter

macro SF-HRD 0.5
  attack   0:80 0.5:18 1:0
  accent   0:10 0.5:70 1:127
  drive    0:0 0.5:28 1:84
  reso     add 0:-24 0.5:0 1:28
  sub      add 0:30 0.5:0 1:-24
  lvl      add 0:4 0.5:0 1:-8      # drive is louder than its own compensation

macro SH-LNG 0.5
  adcy     0:20 0.5:82 1:127
  decay    0:12 0.5:48 1:96
  release  0:4 0.5:32 1:84
  slide    0:6 0.5:50 1:118

macro CL-DRT 0.5
  fold     0.5:0 1:84
  drive    add 0:-20 0.5:0 1:34
  fmix     0:64 0.5:0                # clean: half the tone is the FM pair at depth 0, a pure sine
  fmdepth  0:0 0.5:20 1:20
  sub      mul 0:1.35 0.5:1 1:0.8
  lvl      add 0:0 0.5:0 1:-5
