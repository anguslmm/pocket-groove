# SURGE -- family: ENERGY.
# Idea: MORE is "more of everything at once" (brighter, driven, faster
# wobble, harder attack, snappier envelope, folded harmonics); CALM is not
# "less" but a different kind of quiet: deep, round, slow, gliding, an octave
# of sub underneath. The base is a pulse-wave bass-house stab with a gentle
# square wobble.
# Feel if it works: tilting toward MORE feels like the bass waking up and
# leaning in; toward CALM like it exhales and gets heavier.
# Try: MORE on X, CALM on Y; ride MORE up over four bars into a drop, then
# snap to CALM.
voice bass
name SURGE
base attack=6 wave=88 cutoff=46 reso=62 envmod=56 decay=40 sub=58 lfoshape=sqr lfodepth=10 fmix=0 slide=40 adcy=90

macro MORE
  cutoff   0:34 1:88 smooth
  envmod   add 0:-8 1:34
  drive    0:14 0.6:56 1:92
  fold     0.3:0 1:54
  rate     0:1/4 0.3:1/8 0.6:1/16 0.85:1/16t 1:1/32   # the wobble speeds up in tempo steps
  lfodepth 0:8 1:40
  sub      mul 0:1.1 1:0.55          # the sub steps back so the harmonics lead
  lvl      0:98 0.6:94 1:102         # level the hump in the middle (drive) and the dip at the top (fold)

macro CALM
  cutoff   add 0:0 1:-24
  reso     add 0:0 1:-30
  sub      add 0:0 1:50
  subo     0:uni 0.45:-1oct         # the floor drops an octave a little before halfway
  slide    0:40 1:120
  release  0:20 1:90
  rate     add 0:0 1:-3             # three rates slower than MORE asks for
  lvl      add 0:0 0.45:0 0.5:-3 1:-5   # the -1 oct sub is heavy
